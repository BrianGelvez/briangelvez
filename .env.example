# URL pública del sitio. Se usa para OG images, sitemap.xml y robots.txt.
# En Vercel esto se setea automáticamente (VERCEL_URL) pero conviene fijarlo.
NEXT_PUBLIC_SITE_URL="https://briangelvez.vercel.app"

# ------------------------------------------------------------
#  Resend — formulario de contacto  (https://resend.com)
# ------------------------------------------------------------

# API Key de Resend (requerida para que el form envíe emails).
RESEND_API_KEY=e_fRzwPLGv_AXYQw3tanj85G4hQLYfTT48v

# Email al que llegan los mensajes del formulario.
# En modo sandbox de Resend, tiene que ser el mismo email con el que abriste la cuenta.
CONTACT_EMAIL="briannn97@gmail.com"

# Dirección "From" del email que se envía.
# - Modo sandbox (sin dominio verificado): usá "Portfolio Brian Gelvez <onboarding@resend.dev>"
# - Modo producción (con dominio verificado en Resend): "Portfolio Brian Gelvez <noreply@tu-dominio.com>"
RESEND_FROM_EMAIL="Portfolio Brian Gelvez <onboarding@resend.dev>"
